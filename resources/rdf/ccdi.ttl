    ns1:exampleValue "Within 5 Minutes;6-30 Minutes;31-60 Minutes;After 60 Minutes;etc (see Terms and Values Sets)" ;
    ns1:isCDE 3279220 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "enum" .

<http://syn.org/ccdi/exposure/tobacco_smoking_onset_year> rdfs:label "tobacco_smoking_onset_year" ;
    ns2:description "Tobacco Smoking History Onset Year Date" ;
    ns1:isCDE 14494331 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "integer" .

<http://syn.org/ccdi/exposure/tobacco_smoking_quit_year> rdfs:label "tobacco_smoking_quit_year" ;
    ns2:description "A record of an individual's background in regard to smoking tobacco. This would include such factors as start date, end date (if applicable), number of cigarette smoked, attempts to quit, and others.:The year in which an individual quit smoking.:The particular year an event has happened or will happen." ;
    ns1:isCDE 14494374 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "integer" .

<http://syn.org/ccdi/exposure/tobacco_smoking_status> rdfs:label "tobacco_smoking_status" ;
    ns2:description "A category which describes an individual's history of smoking tobacco." ;
    ns1:exampleValue "1 (Lifelong Non-Smoker);2 (Current Smoker);3 (Current Reformed Smoker for > 15 yrs);4 (Current Reformed Smoker for < or = 15 yrs);etc (see Terms and Values Sets)" ;
    ns1:isCDE 6787413 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "enum" .

<http://syn.org/ccdi/exposure/type_of_smoke_exposure> rdfs:label "type_of_smoke_exposure" ;
    ns2:description "The type of environmental, occupational or consumer-based exposure to airborne gases and particulates produced when materials undergo combustion or thermal decomposition." ;
    ns1:exampleValue "Accidental building fire smoke;Accidental fire smoke, grass;Accidental fire smoke, NOS;Accidental forest fire smoke;etc (see Terms and Values Sets)" ;
    ns1:isCDE 14572339 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "array[enum]" .

<http://syn.org/ccdi/exposure/type_of_tobacco_used> rdfs:label "type_of_tobacco_used" ;
