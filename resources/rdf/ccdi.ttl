<http://syn.org/ccdi/exposure/smoking_frequency> rdfs:label "smoking_frequency" ;
    ns2:description "The number of occurrences of smoking over a time period." ;
    ns1:exampleValue "Every day;Some days;Not Reported;Unknown" ;
    ns1:isCDE 14645982 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "enum" .

<http://syn.org/ccdi/exposure/time_between_waking_and_first_smoke> rdfs:label "time_between_waking_and_first_smoke" ;
