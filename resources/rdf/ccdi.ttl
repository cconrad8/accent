    ns1:node <http://syn.org/ccdi/family_relationship> ;
    ns1:requiredBy <http://syn.org/ccdi/family_relationship> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/generic_file/acl> rdfs:label "acl" ;
    ns2:description "A free text field used to document whether the data in a repository is open access or controlled access. If access to the data are unrestricted, the acl field should be listed [“*]. Controlled access should be denoted as a comma delimited list of phs accession numbers, for example, [“phs000123] or [“phs000123,phs000124]." ;
    ns1:isCDE 11555664 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/generic_file/authz> rdfs:label "authz" ;
    ns2:description "A free text field used to document whether the data in a repository is open access or controlled access. Open access files should have authz = ['/open']. Controlled access files have an acl value format of ['/programs/phsNNN'] (e.g.  ['/programs/1234']." ;
    ns1:isCDE 11555664 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/generic_file/crdc_id> rdfs:label "crdc_id" ;
    ns2:description "The crdc_id is a unique identifier that is generated by CRDC Data Submission Portal." ;
    ns1:isCDE 14534325 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/generic_file/data_category> rdfs:label "data_category" ;
    ns2:description "The data type and data subtype categories used to classify imported data files." ;
    ns1:exampleValue "Clinical;Copy Number Variation;COG Clinical Data;Gene Expression;etc (see Terms and Values Sets)" ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "array[string;enum]" .

<http://syn.org/ccdi/generic_file/dcf_indexd_guid> rdfs:label "dcf_indexd_guid" ;
    ns2:description "A unique sequence of characters used to identify, name, or characterize the indexing process that is different from all other UUIDs/GUIDs generated, making it possible to interoperate with data commons and share data within a data ecosystem." ;
    ns1:isCDE 14576969 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/generic_file/file_access> rdfs:label "file_access" ;
    ns2:description "A enumerated value text field used to document whether the data in a repository is open access or controlled access." ;
    ns1:exampleValue "Controlled;Open" ;
