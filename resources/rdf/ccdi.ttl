<http://syn.org/ccdi/diagnosis/age_at_diagnosis> rdfs:label "age_at_diagnosis" ;
    ns2:description "Age at the time of diagnosis expressed in number of days since birth." ;
    ns1:isCDE 15019300 ;
    ns1:isCDEVersion 2e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "integer" .

<http://syn.org/ccdi/diagnosis/anatomic_site> rdfs:label "anatomic_site" ;
    ns2:description "The location within the body as captured in the topography label of the International Classification of Diseases for Oncology, 3rd Edition (ICD-O-3)." ;
    ns1:exampleValue "C76.2 : Abdomen, NOS;C15.2 : Abdominal esophagus;C31.9 : Accessory sinus, NOS;C72.4 : Acoustic nerve;etc (see Terms and Values Sets)" ;
    ns1:isCDE 14156279 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "array[string;enum]" .

<http://syn.org/ccdi/diagnosis/diagnosis> rdfs:label "diagnosis" ;
    ns2:description "The term which identifies normal and abnormal cells and tissues used to define the presence and nature of disease, as categorized by diagnosis_classification_system property." ;
    ns1:exampleValue "[---- Childhood Cancer Diagnosis ----];Acoustic Neuroma;Acute Basophilic Leukemia;Acute Erythroid Leukemia : M6;etc (see Terms and Values Sets)" ;
    ns1:isCDE 14714127 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/diagnosis_basis> rdfs:label "diagnosis_basis" ;
    ns2:description "The underlying scientific foundation used to determine the diagnosis." ;
    ns1:exampleValue "Clinical;Molecular;Pathology;Unknown;etc (see Terms and Values Sets)" ;
    ns1:isCDE 14714146 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/diagnosis_classification_system> rdfs:label "diagnosis_classification_system" ;
    ns2:description "The standard or agency upon which the specific term used as the diagnosis value was obtained." ;
    ns1:exampleValue "CNS Diagnosis Category;French-American-British Classification;ICD-O-3.2;Indication for Study;etc (see Terms and Values Sets)" ;
    ns1:isCDE 15026558 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/diagnosis_comment> rdfs:label "diagnosis_comment" ;
    ns2:description "Words that describe observations or explanations related to the diagnosis." ;
    ns1:isCDE 14714147 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string" .

<http://syn.org/ccdi/diagnosis/diagnosis_id> rdfs:label "diagnosis_id" ;
    ns2:description "A sequence of characters used to uniquely identify, name, or characterize the presence and nature of a disease or condition." ;
    ns1:isCDE 14540952 ;
    ns1:isKey true ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string" .

<http://syn.org/ccdi/diagnosis/disease_phase> rdfs:label "disease_phase" ;
    ns2:description "The stage or period of an individual's treatment process during which relevant observations were recorded." ;
    ns1:exampleValue "Initial Diagnosis;Not Reported;Post-Mortem;Progression;etc (see Terms and Values Sets)" ;
    ns1:isCDE 12217251 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/id> rdfs:label "id" ;
    ns2:description "A unique sequence of characters used to identify, name, or characterize an attribute shared by all members of a class." ;
    ns1:isCDE 14534325 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:isKey false ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string" .

<http://syn.org/ccdi/diagnosis/laterality> rdfs:label "laterality" ;
    ns2:description "Designates the side of the body where disease is found." ;
    ns1:exampleValue "Bilateral;Left;Midline;Not Applicable;etc (see Terms and Values Sets)" ;
    ns1:isCDE 15157293 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "enum" .

<http://syn.org/ccdi/diagnosis/toronto_childhood_cancer_staging> rdfs:label "toronto_childhood_cancer_staging" ;
    ns2:description "Cancer stage as captured by the Toronto Childhood Cancer Stage Guidelines." ;
    ns1:exampleValue "Acute lymphoblastic leukemia CNS1;Acute lymphoblastic leukemia CNS2;Acute lymphoblastic leukemia CNS3;Astrocytomas Localized;etc (see Terms and Values Sets)" ;
    ns1:isCDE 13299113 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "enum" .

<http://syn.org/ccdi/diagnosis/tumor_classification> rdfs:label "tumor_classification" ;
    ns2:description "The classification of a tumor based primarily on histopathological characteristics." ;
    ns1:exampleValue "Primary;Regional;Metastatic;Unknown;etc (see Terms and Values Sets)" ;
    ns1:isCDE 12922545 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:requiredBy <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/tumor_grade> rdfs:label "tumor_grade" ;
    ns2:description "A text term to express the degree of abnormality of cancer cells as a measure of differentiation and aggressiveness." ;
    ns1:exampleValue "G1;G2;G3;G4;etc (see Terms and Values Sets)" ;
    ns1:isCDE 11325685 ;
    ns1:isCDEVersion 3e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/tumor_grade_source> rdfs:label "tumor_grade_source" ;
    ns2:description "A text term for the origin of tumor grade permissible values." ;
    ns1:isCDE 11325685 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string" .

<http://syn.org/ccdi/diagnosis/tumor_stage_clinical_m> rdfs:label "tumor_stage_clinical_m" ;
    ns2:description "Extent of the distant metastasis for the cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    ns1:exampleValue "cM0 (i+);M0;M1;M1a;etc (see Terms and Values Sets)" ;
    ns1:isCDE 3440331 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/tumor_stage_clinical_n> rdfs:label "tumor_stage_clinical_n" ;
    ns2:description "Extent of the regional lymph node involvement for the cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    ns1:exampleValue "N0;N0 (i-);N0 (i+);N0 (mol-);etc (see Terms and Values Sets)" ;
    ns1:isCDE 3440330 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/tumor_stage_clinical_t> rdfs:label "tumor_stage_clinical_t" ;
    ns2:description "Extent of the primary cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    ns1:exampleValue "T0;T1;T1a;T1a1;etc (see Terms and Values Sets)" ;
    ns1:isCDE 3440328 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/tumor_stage_source> rdfs:label "tumor_stage_source" ;
    ns2:description "Code of pathological T (primary tumor) to define the size or contiguous extension of the primary tumor (T), using staging criteria from the American Joint Committee on Cancer (AJCC)." ;
    ns1:exampleValue "AJCC Metastasis M Stage;AJCC Lymph Node N Stage;AJCC Tumor T Stage;Toronto Childhood Cancer Stage Guidelines" ;
    ns1:isCDE 13299113 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/diagnosis/year_of_diagnosis> rdfs:label "year_of_diagnosis" ;
    ns2:description "The year in which a subject was diagnosed." ;
    ns1:isCDE 15157224 ;
    ns1:node <http://syn.org/ccdi/diagnosis> ;
    ns1:type "string" .

<http://syn.org/ccdi/exposure/age_at_exposure> rdfs:label "age_at_exposure" ;
    ns2:description "The age (in days) of subject at a known exposure to a hazardous factor or substance." ;
    ns1:isCDE 14589582 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:requiredBy <http://syn.org/ccdi/exposure> ;
    ns1:type "integer" .

<http://syn.org/ccdi/exposure/alcohol_days_per_week> rdfs:label "alcohol_days_per_week" ;
    ns2:description "Numeric value used to describe the average number of days each week that a person consumes an alcoholic beverage." ;
    ns1:isCDE 3114013 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "number" .

<http://syn.org/ccdi/exposure/alcohol_drinks_per_day> rdfs:label "alcohol_drinks_per_day" ;
    ns2:description "Numeric value used to describe the average number of alcoholic beverages a person consumes per day." ;
    ns1:isCDE 3124961 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "number" .

<http://syn.org/ccdi/exposure/alcohol_history> rdfs:label "alcohol_history" ;
    ns2:description "Has the participant consumed at least 12 drinks of any kind of alcoholic beverage in their lifetime?" ;
    ns1:exampleValue "Yes;No;Unknown;Not Reported" ;
    ns1:isCDE 7537144 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "enum" .

<http://syn.org/ccdi/exposure/alcohol_intensity> rdfs:label "alcohol_intensity" ;
    ns2:description "Category to describe the patient's current level of alcohol use as self-reported by the patient." ;
    ns1:exampleValue "Drinker;Heavy Drinker;Lifelong Non-Drinker;Non-Drinker;etc (see Terms and Values Sets)" ;
    ns1:isCDE 3457767 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "enum" .

<http://syn.org/ccdi/exposure/asbestos_exposure> rdfs:label "asbestos_exposure" ;
    ns2:description "The category related to contact with chemical, biological, or physical substances found in air, water, food, soil, or product that may have a harmful effect on a person's health." ;
    ns1:exampleValue "Yes;No;Unknown;Not Reported" ;
    ns1:isCDE 11256813 ;
    ns1:node <http://syn.org/ccdi/exposure> ;
    ns1:type "enum" .

