    ns1:isCDE 11284037 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "string" .

