    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "enum" .

<http://syn.org/ccdi/generic_file/file_description> rdfs:label "file_description" ;
    ns2:description "A free text field that can be used to document the content and other details about an electronic file that may not be captured elsewhere." ;
    ns1:isCDE 11280338 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/generic_file/file_mapping_level> rdfs:label "file_mapping_level" ;
    ns2:description "Describes if the file is associated with the Participant, a Sample, or a Study." ;
    ns1:exampleValue "Participant;Sample;Study" ;
    ns1:isCDE 11595478 ;
    ns1:node <http://syn.org/ccdi/generic_file> ;
    ns1:requiredBy <http://syn.org/ccdi/generic_file> ;
    ns1:type "enum" .

<http://syn.org/ccdi/generic_file/file_name> rdfs:label "file_name" ;
