@prefix ns1: <http://syn.org/> .
@prefix ns2: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://syn.org/ccdi/cell_line/cell_line_id> rdfs:label "cell_line_id" ;
    ns2:description "A sequence of characters used to identify, name, or characterize a permanently established cell culture that will proliferate indefinitely given appropriate fresh medium and space." ;
    ns1:isCDE 14596104 ;
    ns1:isKey true ;
    ns1:node <http://syn.org/ccdi/cell_line> ;
    ns1:requiredBy <http://syn.org/ccdi/cell_line> ;
    ns1:type "string" .

<http://syn.org/ccdi/cell_line/id> rdfs:label "id" ;
    ns2:description "A unique sequence of characters used to identify, name, or characterize an attribute shared by all members of a class." ;
    ns1:isCDE 14534325 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:isKey false ;
    ns1:node <http://syn.org/ccdi/cell_line> ;
    ns1:type "string" .

<http://syn.org/ccdi/cell_line/source> rdfs:label "source" ;
    ns2:description "The words by which a permanently established cell culture that will proliferate indefinitely given appropriate fresh medium and space is known." ;
    ns1:isCDE 14596139 ;
    ns1:node <http://syn.org/ccdi/cell_line> ;
    ns1:requiredBy <http://syn.org/ccdi/cell_line> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/acl> rdfs:label "acl" ;
    ns2:description "A free text field used to document whether the data in a repository is open access or controlled access. If access to the data are unrestricted, the acl field should be listed [“*]. Controlled access should be denoted as a comma delimited list of phs accession numbers, for example, [“phs000123] or [“phs000123,phs000124]." ;
    ns1:isCDE 11555664 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/authz> rdfs:label "authz" ;
    ns2:description "A free text field used to document whether the data in a repository is open access or controlled access. Open access files should have authz = ['/open']. Controlled access files have an acl value format of ['/programs/phsNNN'] (e.g.  ['/programs/1234']." ;
    ns1:isCDE 11555664 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/checksum_algorithm> rdfs:label "checksum_algorithm" ;
    ns2:description "The method by which the file checksum was calculated." ;
    ns1:isCDE 11475057 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/checksum_value> rdfs:label "checksum_value" ;
    ns2:description "A small-sized block of data derived from a file for the purpose of detecting errors that may have been introduced during file transmission and/or storage and used to verify data integrity." ;
    ns1:isCDE 11480133 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/clinical_measure_file_id> rdfs:label "clinical_measure_file_id" ;
    ns2:description "A sequence of characters used to uniquely identify, name, or characterize a data file stored as an electronic record." ;
    ns1:isCDE 14528010 ;
    ns1:isKey true ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/crdc_id> rdfs:label "crdc_id" ;
    ns2:description "The crdc_id is a unique identifier that is generated by CRDC Data Submission Portal." ;
    ns1:isCDE 14534325 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/data_category> rdfs:label "data_category" ;
    ns2:description "The data type and data subtype categories used to classify imported data files." ;
    ns1:exampleValue "Clinical;Copy Number Variation;COG Clinical Data;Gene Expression;etc (see Terms and Values Sets)" ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "array[string;enum]" .

<http://syn.org/ccdi/clinical_measure_file/dcf_indexd_guid> rdfs:label "dcf_indexd_guid" ;
    ns2:description "A unique sequence of characters used to identify, name, or characterize the indexing process that is different from all other UUIDs/GUIDs generated, making it possible to interoperate with data commons and share data within a data ecosystem." ;
    ns1:isCDE 14576969 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/file_access> rdfs:label "file_access" ;
    ns2:description "A enumerated value text field used to document whether the data in a repository is open access or controlled access." ;
    ns1:exampleValue "Controlled;Open" ;
    ns1:isCDE 11555664 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "enum" .

<http://syn.org/ccdi/clinical_measure_file/file_description> rdfs:label "file_description" ;
    ns2:description "A free text field that can be used to document the content and other details about an electronic file that may not be captured elsewhere." ;
    ns1:isCDE 11280338 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/file_mapping_level> rdfs:label "file_mapping_level" ;
    ns2:description "Describes if the file is associated with the Participant, a Sample, or a Study." ;
    ns1:exampleValue "Participant;Sample;Study" ;
    ns1:isCDE 11595478 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "enum" .

<http://syn.org/ccdi/clinical_measure_file/file_name> rdfs:label "file_name" ;
    ns2:description "The literal label for an electronic data file." ;
    ns1:isCDE 11284037 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/file_size> rdfs:label "file_size" ;
    ns2:description "The measure (in bytes) of how much space a data file takes up on a storage medium" ;
    ns1:isCDE 11479876 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "integer" .

<http://syn.org/ccdi/clinical_measure_file/file_type> rdfs:label "file_type" ;
    ns2:description "A defined organization or layout representing and structuring data in a computer file." ;
    ns1:exampleValue "bam;bam_index;bai;bcf;etc (see Terms and Values Sets)" ;
    ns1:isCDE 11416926 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string;enum" .

<http://syn.org/ccdi/clinical_measure_file/file_url> rdfs:label "file_url" ;
    ns2:description "The specification of a node (file or directory) in a hierarchical file system where an electronic file is located." ;
    ns1:isCDE 11556141 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/id> rdfs:label "id" ;
    ns2:description "A unique sequence of characters used to identify, name, or characterize an attribute shared by all members of a class." ;
    ns1:isCDE 14534325 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:isKey false ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/md5sum> rdfs:label "md5sum" ;
    ns2:description "A 32-character hexadecimal number that is computed on a file." ;
    ns1:isCDE 11556150 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:requiredBy <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

<http://syn.org/ccdi/clinical_measure_file/participant_list> rdfs:label "participant_list" ;
    ns2:description "A series of characters, one after the other, used to uniquely identify the subjects who have taken part in the investigation or research study." ;
    ns1:isCDE 14608610 ;
    ns1:node <http://syn.org/ccdi/clinical_measure_file> ;
    ns1:type "string" .

