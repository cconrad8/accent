    ns1:isCDE 14534325 ;
    ns1:isCDEVersion 1e+00 ;
    ns1:isKey false ;
    ns1:node <http://syn.org/ccdi/family_relationship> ;
    ns1:type "string" .

<http://syn.org/ccdi/family_relationship/related_to_participant_id> rdfs:label "related_to_participant_id" ;
    ns2:description "A sequence of characters used to uniquely identify, name, or characterize the state of connectedness between members of the unit of society organized around kinship ties." ;
